# Copie para .env.local e preencha. O .env.local não vai para o Git.
#
# Nenhuma variável precisa ser digitada à mão: todas são criadas e injetadas
# pela Vercel ao conectar o Blob store ao projeto. Traga com `vercel env pull`.

# --- Vercel Blob (progresso do checklist do /plano) --------------------
#
# O store precisa ser criado com acesso PRIVATE — é o que a rota
# app/api/plano/progresso usa.
#
# A autenticação é por OIDC: o VERCEL_OIDC_TOKEN é emitido em runtime
# (curto e rotacionado sozinho) e o BLOB_STORE_ID diz em qual store gravar.
# Não existe BLOB_READ_WRITE_TOKEN nesse modo — ele só aparece se você
# gerar um token estático à mão, para rodar fora da Vercel.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
