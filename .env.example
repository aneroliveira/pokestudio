# Copie para .env.local e preencha. O .env.local não vai para o Git.

# Senha para marcar os passos em /plano. Sem ela a página abre em modo
# leitura — nunca em modo aberto, para o endpoint de escrita não ficar
# exposto por esquecimento. Esta é a única variável que você define à mão.
PLANO_SENHA=

# --- Vercel Blob (progresso do checklist) -----------------------------
# As três variáveis abaixo são criadas e injetadas pela Vercel ao conectar
# o Blob store ao projeto. Não preencha à mão: traga com `vercel env pull`.
#
# O store precisa ser criado com acesso PRIVATE — é o que o código usa em
# app/api/plano/progresso/route.ts.
#
# Por padrão a autenticação é por OIDC (credencial curta, rotacionada
# sozinha); o token estático entra como reserva para código fora da Vercel.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=
