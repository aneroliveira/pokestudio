# Copie para .env.local e preencha. O .env.local não vai para o Git.

# Senha para marcar os passos em /plano. Sem ela a página abre em modo
# leitura — nunca em modo aberto, para o endpoint de escrita não ficar
# exposto por esquecimento.
PLANO_SENHA=

# Token do Vercel Blob, onde o progresso do checklist é guardado.
# Entra sozinho no projeto quando o Blob store é criado no painel da Vercel.
# Para rodar local, traga com: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
